    {
      "id": "flop-agent-unlock-ratio",
      "statement": "It arrives locked and spendable only on inference or staking - every 3 $FLOP spent on inference unlocks 1 airdropped $FLOP, so agents must use the network to make it liquid.",
      "statementIsQuotation": true,
      "status": "official-draft",
      "effectiveNetworkPhase": "mainnet",
      "formula": {
        "kind": "unlock-ratio",
        "cohort": "agents",
        "spentPerUnlocked": 3,
        "unlockedPerRatio": 1,
        "unit": "FLOP",
        "expression": "unlocked = floor(inferenceSpend / spentPerUnlocked) * unlockedPerRatio",
